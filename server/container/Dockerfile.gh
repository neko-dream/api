FROM  --platform=linux/arm64 alpine:latest

EXPOSE 3000
ARG ENV=dev

COPY ./server /server

RUN  apk add shadow
RUN  useradd api && \
  mkdir -p /var/lib/amazon && \
  chmod 750 /var/lib/amazon && \
  mkdir -p /var/log/amazon && \
  chmod 700 /var/log/amazon && \
  chmod +x /server

# OTel Collector の設定は dev にしかない(本番のタスク定義にはコレクターがない)ため、ある場合だけ配置する
RUN --mount=type=bind,source=.ecspresso/api,target=/tmp/ecspresso \
  if [ -f "/tmp/ecspresso/${ENV}/otel.yaml" ]; then \
    mkdir -p /etc/ecs && cp "/tmp/ecspresso/${ENV}/otel.yaml" /etc/ecs/otel.yaml; \
  fi

# ECS must explicitly opt into development; a standalone image defaults closed.
ENV ENV=production

VOLUME /var/lib/amazon /var/log/amazon /etc/ecs

CMD ["./server"]
